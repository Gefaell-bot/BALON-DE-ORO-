                          0.25,
                          "$bdo.components.titles"
                        ]
                      },
                      {
                        "$multiply": [
                          0.15,
                          "$bdo.components.market"
                        ]
                      },
                      {
                        "$multiply": [
                          0.15,
                          "$bdo.components.ucl"
                        ]
                      },
                      {
                        "$multiply": [
                          0.1,
                          "$bdo.components.ga90"
                        ]
                      },
                      {
                        "$multiply": [
                          0.1,
                          "$bdo.components.win_rate"
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        }
      },
      {
        "$addFields": {
          "bdo.tier": {
            "$switch": {
              "branches": [
                {
                  "case": {
                    "$gte": [
                      "$bdo.score",
                      55
                    ]
                  },
                  "then": "Favoritos"
                },
                {
                  "case": {
                    "$gte": [
                      "$bdo.score",
                      40
                    ]
                  },
                  "then": "Contendientes"
                },
                {
                  "case": {
                    "$gte": [
                      "$bdo.score",
                      25
                    ]
                  },
                  "then": "Aspirantes"
                }
              ],
              "default": "Resto"
            }
          }
        }
      },
      {
        "$facet": {
          "leaderboard": [
            {
              "$limit": 10
            },
            {
              "$project": {
                "_id": 0,
                "player_id": 1,
                "season": 1,
                "name": 1,
                "image_url": 1,
                "age": 1,
                "nationality": 1,
                "position": 1,
                "sub_position": 1,
                "club": 1,
                "league": 1,
                "performance": 1,
                "ucl": 1,
                "titles": 1,
                "title_points": 1,
                "market_value_eur": 1,
                "ml": 1,
                "bdo": 1,
                "ballon_dor_rank": 1
              }
            }
          ],
          "tiers": [
            {
              "$bucket": {
                "groupBy": "$bdo.score",
                "boundaries": [
                  0,
                  25,
                  40,
                  55,
                  100.1
                ],
                "default": "sin_puntuar",
                "output": {
                  "count": {
                    "$sum": 1
                  },
                  "avg_age": {
                    "$avg": "$age"
                  },
                  "top": {
                    "$topN": {
                      "n": 5,
                      "sortBy": {
                        "bdo.score": -1
                      },
                      "output": {
                        "player_id": "$player_id",
                        "name": "$name",
                        "score": "$bdo.score"
                      }
                    }
                  }
                }
              }
            }
          ],
          "promesas": [
            {
              "$match": {
                "age": {
                  "$lte": 21
                }
              }
            },
            {
              "$sort": {
                "bdo.score": -1
              }
            },
            {
              "$limit": 6
            },
            {
              "$project": {
                "_id": 0,
                "player_id": 1,
                "name": 1,
                "age": 1,
                "club": 1,
                "image_url": 1,
                "bdo.score": 1,
                "ml.probability": 1,
                "performance.ga": 1
              }
            }
          ],
          "market_bands": [
            {
              "$bucketAuto": {
                "groupBy": "$market_value_eur",
                "buckets": 5,
                "output": {
                  "count": {
                    "$sum": 1
                  },
                  "avg_score": {
                    "$avg": "$bdo.score"
                  }
                }
              }
            }
          ],
          "summary": [
            {
              "$group": {
                "_id": null,
                "candidates": {
                  "$sum": 1
                },
                "avg_score": {
                  "$avg": "$bdo.score"
                },
                "goals": {
                  "$sum": "$performance.goals"
                },
                "assists": {
                  "$sum": "$performance.assists"
                },
                "max_score": {
                  "$max": "$bdo.score"
                }
              }
            },
            {
              "$project": {
                "_id": 0
              }
            }
          ]
        }
      }
    ],
    "cursor": {},
    "$db": "balon_de_oro"
  },
  "ok": 1.0
}